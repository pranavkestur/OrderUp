# =============================================================================
# OrderUp secrets & env for the Linux VPS deployment.
#
# Copy to /opt/orderup/orderup.env on the VPS (chmod 600) and fill in the
# real values. All four systemd units source this file via EnvironmentFile=.
#
# This file is git-ignored (.gitignore covers /deploy/systemd/orderup.env).
# =============================================================================

# --- Java runtime location (adjust if you install a different JDK path).
JAVA_HOME=/usr/lib/jvm/java-21-amazon-corretto

# --- Kite Connect (Zerodha) API credentials.
# From https://developers.kite.trade/apps — the app whose "Allowed IPs" list
# must include the VPS's static public IP.
KITE_API_KEY=6b6dvo1tmh7ofz68
KITE_API_SECRET=67j4kpmob2akyco2k3pl5nl7ivmedhls
KITE_USER_ID=

# --- Telegram alerts.
TELEGRAM_BOT_TOKEN=8838501098:AAFbdt2QkSat7X-7HtdgUpdPH_r7IdiFvTc
TELEGRAM_CHAT_ID=-5431538070

# --- Chartink webhook shared secret. This is the {secret} path segment in
# the URL you paste into Chartink's Create-Alert form:
#     https://<launcher-domain>/chartink/webhook/{secret}
# Rotate with: openssl rand -hex 20
CHARTINK_SECRET=e093b64e88ba61a1300312baf7424312b047f0df

# --- orderup-launcher control-plane secret. This is the {secret} in the
# lifecycle URLs your iOS Shortcuts hit:
#     https://<launcher-domain>/lifecycle/{secret}/chartink/start
LAUNCHER_SECRET=cdb17863e5d437fd1c02638799de8fc6f900ffb7

# --- Spring Boot listens locally on this port. The launcher (on 8080) reverse-
# proxies here. Chartink app never talks to the internet directly.
SERVER_PORT=8090

# --- Reverse-proxy config for the launcher. Do not change unless you know why.
LAUNCHER_PORT=8080
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=8090

# --- ngrok agent auth token — grab from https://dashboard.ngrok.com/get-started/your-authtoken
# Baked into ~/.config/ngrok/ngrok.yml by bootstrap.sh, not read directly by
# the service, but keeping it here makes bootstrap idempotent.
NGROK_AUTHTOKEN=3ILbUCOMhtjwNczwOoylRnTEqQW_7nL78pYPMCgf1814hsPrH

# --- Reserved static ngrok domain (no protocol, no path).
NGROK_STATIC_DOMAIN=marbles-pamphlet-wages.ngrok-free.dev

